{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Device Identity Schema",
    "type": "object",
    "required": [
        "policy",
        "incremental_counter",
        "initial_value"
    ],
    "properties": {
        "policy": {
            "type": "object",
            "required": [
                "platform",
                "version",
                "type"
            ],
            "properties": {
                "platform": {
                    "type": "string"
                },
                "version": {
                    "type": "number",
                    "minimum": 1.0,
                    "maximum": 99.99
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "incremental_counter": {
            "type": "object",
            "required": [
                "value"
            ],
            "properties": {
                "value": {
                    "type": "string"
                }
            }
        },
        "initial_value": {
            "type": "object",
            "required": [
                "value"
            ],
            "properties": {
                "value": {
                    "type": "string"
                }
            }
        }
    }
}
